# local: datos de demostración persistentes en este dispositivo
# google-sheets: API de Google Apps Script protegida
VITE_DATA_PROVIDER=local

# Solo se usa en modo local. SHA-256 del PIN, nunca el PIN en texto plano.
# PIN del cuerpo técnico Senior: 9677 (aquí solo se conserva su hash)
VITE_STAFF_PIN_SHA256=1765487b78f627ed20e5506daeeb0b6a80fd9ba050445ad8ce291b8083745eeb

# URL /exec del despliegue de Google Apps Script
VITE_APPS_SCRIPT_URL=

# URL pública final del Senior
VITE_PUBLIC_URL=http://localhost:4173

# Ruta base. Use / con rendimiento.atleticozabal.com.
# Para una URL temporal usuario.github.io/repositorio use /repositorio/.
VITE_BASE_PATH=/
